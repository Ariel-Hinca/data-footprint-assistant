@page "/profile"
@inject ProfileService Profiles

<PageTitle>My details — Data Footprint</PageTitle>

<section class="sheet">
    <header class="page-head">
        <h1>My details</h1>
        <p class="lede">Stored only on this computer.</p>
    </header>

    <label class="field">
        <span>Full name</span>
        <input value="@fullName" @oninput="OnName" autocomplete="name" />
    </label>

    <fieldset class="group">
        <legend>Email addresses</legend>
        @for (var i = 0; i < emails.Count; i++)
        {
            var index = i;
            <div class="inline-field">
                <input type="email" aria-label="Email address" value="@emails[index]" @oninput="(e) => OnEmail(index, e)" autocomplete="email" />
                <button type="button" class="text-button" @onclick="() => RemoveEmail(index)">Remove</button>
            </div>
        }
        <button type="button" class="text-button" @onclick="AddEmail">Add an email</button>
    </fieldset>

    <fieldset class="group">
        <legend>Phone numbers</legend>
        @for (var i = 0; i < phones.Count; i++)
        {
            var index = i;
            <div class="inline-field">
                <input type="tel" aria-label="Phone number" value="@phones[index]" @oninput="(e) => OnPhone(index, e)" autocomplete="tel" />
                <button type="button" class="text-button" @onclick="() => RemovePhone(index)">Remove</button>
            </div>
        }
        <button type="button" class="text-button" @onclick="AddPhone">Add a phone number</button>
    </fieldset>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p class="form-error" role="alert">@error</p>
    }

    <div class="button-row">
        <button type="button" class="button" @onclick="SaveAsync">Save</button>
        @if (saved)
        {
            <span class="saved" role="status">Saved.</span>
        }
    </div>
</section>

@code {
    private string fullName = "";
    private List<string> emails = [""];
    private List<string> phones = [""];
    private string error = "";
    private bool saved;

    protected override async Task OnInitializedAsync()
    {
        var profile = await Profiles.GetAsync();
        fullName = profile.FullName;
        emails = profile.Emails.Count == 0 ? [""] : profile.Emails;
        phones = profile.Phones.Count == 0 ? [""] : profile.Phones;
    }

    private void OnName(ChangeEventArgs args)
    {
        fullName = args.Value?.ToString() ?? "";
        Touch();
    }

    private void OnEmail(int index, ChangeEventArgs args)
    {
        emails[index] = args.Value?.ToString() ?? "";
        Touch();
    }

    private void OnPhone(int index, ChangeEventArgs args)
    {
        phones[index] = args.Value?.ToString() ?? "";
        Touch();
    }

    private void AddEmail()
    {
        emails.Add("");
        Touch();
    }

    private void AddPhone()
    {
        phones.Add("");
        Touch();
    }

    private void RemoveEmail(int index)
    {
        emails.RemoveAt(index);
        if (emails.Count == 0)
        {
            emails.Add("");
        }

        Touch();
    }

    private void RemovePhone(int index)
    {
        phones.RemoveAt(index);
        if (phones.Count == 0)
        {
            phones.Add("");
        }

        Touch();
    }

    private void Touch()
    {
        saved = false;
        error = "";
    }

    private async Task SaveAsync()
    {
        var cleanEmails = emails.Select(email => email.Trim()).Where(email => email.Length > 0).ToList();
        var cleanPhones = phones.Select(phone => phone.Trim()).Where(phone => phone.Length > 0).ToList();

        if (cleanEmails.Any(email => !email.Contains('@')))
        {
            error = "Check the email addresses. Each one needs an @ sign.";
            saved = false;
            return;
        }

        await Profiles.SaveAsync(fullName, cleanEmails, cleanPhones);
        emails = cleanEmails.Count == 0 ? [""] : cleanEmails;
        phones = cleanPhones.Count == 0 ? [""] : cleanPhones;
        error = "";
        saved = true;
    }
}
