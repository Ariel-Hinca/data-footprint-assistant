@if (Broker is not null)
{
    <div class="scrim" @ref="scrim" @onclick="CloseAsync" @onkeydown="OnKey" tabindex="-1">
        <aside class="panel" @onclick:stopPropagation="true" aria-labelledby="broker-panel-title">
            <div class="panel-head">
                <h2 id="broker-panel-title">@Broker.Name</h2>
                <button type="button" class="icon-button" @onclick="CloseAsync">Close</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Broker.Hint))
            {
                <p class="quiet">@Broker.Hint</p>
            }

            <p><a class="text-link" href="@Broker.OptOutUrl" target="_blank" rel="noopener noreferrer">Open the official page</a></p>

            <label class="field">
                <span>Status</span>
                <select value="@status.ToString()" @onchange="OnStatusChanged">
                    <option value="@BrokerStatus.NotStarted">Not started</option>
                    <option value="@BrokerStatus.RequestSent">Request sent</option>
                    <option value="@BrokerStatus.ConfirmedDeleted">Confirmed deleted</option>
                    <option value="@BrokerStatus.NeedsFollowUp">Needs follow-up</option>
                </select>
            </label>

            <label class="field">
                <span>Date of last action</span>
                <input type="date" value="@dateText" @onchange="OnDateChanged" />
            </label>

            <label class="field">
                <span>Notes</span>
                <textarea rows="4" @bind="notes" @bind:event="oninput" @bind:after="ClearSaved"></textarea>
            </label>

            <div class="button-row">
                <button type="button" class="button" @onclick="SaveNotesAsync">Save notes</button>
                <a class="button button-secondary" href="@RequestHref">Write a request</a>
            </div>
            @if (!string.IsNullOrWhiteSpace(savedMessage))
            {
                <p class="saved" role="status">@savedMessage</p>
            }

            <SearchLinks Profile="Profile" />
        </aside>
    </div>
}

@code {
    private ElementReference scrim;
    private string loadedKey = "";
    private BrokerStatus status;
    private string notes = "";
    private string dateText = "";
    private string savedMessage = "";
    private bool focusPanel;

    [Parameter]
    public BrokerRecord? Broker { get; set; }

    [Parameter]
    public ProfileData Profile { get; set; } = new();

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Inject]
    private BrokerService Brokers { get; set; } = default!;

    private string RequestHref => Broker is null
        ? "request"
        : $"request?broker={Uri.EscapeDataString(Broker.BrokerKey)}&step=2";

    protected override void OnParametersSet()
    {
        if (Broker is null || Broker.BrokerKey == loadedKey)
        {
            return;
        }

        loadedKey = Broker.BrokerKey;
        status = Broker.Status;
        notes = Broker.Notes;
        dateText = Broker.LastActionDate?.ToString("yyyy-MM-dd") ?? "";
        savedMessage = "";
        focusPanel = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPanel && Broker is not null)
        {
            focusPanel = false;
            await scrim.FocusAsync();
        }
    }

    private async Task OnKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        loadedKey = "";
        await OnClose.InvokeAsync();
    }

    private async Task OnStatusChanged(ChangeEventArgs args)
    {
        if (!Enum.TryParse<BrokerStatus>(args.Value?.ToString(), out var next))
        {
            return;
        }

        status = next;
        if (string.IsNullOrWhiteSpace(dateText))
        {
            dateText = DateTime.Today.ToString("yyyy-MM-dd");
        }

        await SaveAsync("Status saved.");
    }

    private void OnDateChanged(ChangeEventArgs args)
    {
        dateText = args.Value?.ToString() ?? "";
        savedMessage = "";
    }

    private void ClearSaved() => savedMessage = "";

    private Task SaveNotesAsync() => SaveAsync("Saved.");

    private async Task SaveAsync(string message)
    {
        if (Broker is null)
        {
            return;
        }

        DateTime? date = DateTime.TryParse(dateText, out var parsed) ? parsed.Date : null;
        await Brokers.SaveDetailsAsync(Broker.BrokerKey, status, date, notes);
        savedMessage = message;
        await OnChanged.InvokeAsync();
    }
}
